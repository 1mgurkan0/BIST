{% extends "base.html.twig" %}
{% block title %}{{ post.metaTitle ?: post.title }} - BAM Terminal{% endblock %}
{% block meta_description %}{{ post.metaDescription ?: post.excerpt ?: '' }}{% endblock %}
{% block robots %}index, follow{% endblock %}
{% block og_title %}{{ post.metaTitle ?: post.title }}{% endblock %}

{% block content %}
<div class="container py-5 mt-4" style="max-width: 800px;">
    {% if post.category %}
        <span class="badge bg-warning text-dark mb-3">{{ post.category.name }}</span>
    {% endif %}

    <h1 class="text-light fw-bold mb-3">{{ post.title }}</h1>

    <div class="text-secondary mb-4 d-flex align-items-center gap-3 flex-wrap">
        <span><i class="bi bi-calendar3"></i> {{ post.publishedAt|date('d.m.Y') }}</span>
        {% if post.tags is not empty %}
            <span>
                {% for tag in post.tags %}
                    <span class="badge bg-secondary bg-opacity-25 text-secondary">#{{ tag.name }}</span>
                {% endfor %}
            </span>
        {% endif %}
    </div>

    {% if post.ogImage %}
        <img src="{{ asset(post.ogImage.path) }}" alt="{{ post.ogImage.altText ?: post.title }}" class="w-100 rounded mb-4" style="max-height: 420px; object-fit: cover;">
    {% endif %}

    <div class="ai-summary-box lh-lg" style="font-size: 1.05rem;">
        {{ post.content|raw }}
    </div>

    <div class="mt-5 pt-4 border-top border-secondary border-opacity-25">
        <a href="{{ path('app_blog') }}" class="text-warning text-decoration-none">
            <i class="bi bi-arrow-left"></i> Tüm yazılara dön
        </a>
    </div>
</div>
{% endblock %}
