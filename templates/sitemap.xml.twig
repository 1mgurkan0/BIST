<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <url>
        <loc>https://www.bamterminal.com.tr{{ path('app-home') }}</loc>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>https://www.bamterminal.com.tr{{ path('app_blog') }}</loc>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>https://www.bamterminal.com.tr{{ path('app_about') }}</loc>
        <priority>0.5</priority>
    </url>
    <url>
        <loc>https://www.bamterminal.com.tr{{ path('app_contact') }}</loc>
        <priority>0.5</priority>
    </url>
    {% for post in posts %}
    <url>
        <loc>https://www.bamterminal.com.tr{{ path('app_blog_show', {slug: post.slug}) }}</loc>
        <lastmod>{{ post.updatedAt ? post.updatedAt|date('Y-m-d') : post.publishedAt|date('Y-m-d') }}</lastmod>
        <priority>0.6</priority>
    </url>
    {% endfor %}
</urlset>
