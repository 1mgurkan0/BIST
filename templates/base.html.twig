<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}BAM (Borsa Analiz Motoru) ile Borsa İstanbul (BIST) hisselerini yapay zeka ve algoritmik sistemlerle analiz edin, fırsatları yakalayın.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="https://www.bamterminal.com.tr{{ app.request.pathInfo }}">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="https://www.bamterminal.com.tr{{ app.request.pathInfo }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://www.bamterminal.com.tr/images/og-image.png">
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="https://www.bamterminal.com.tr/images/og-image.png">
    
    <title>{% block title %}BAM - Borsa Analiz Motoru{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <style>
        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background-color: #121826;
            color: #f3f4f6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main { flex: 1; }

        .card-custom {
            background-color: #1f2937;
            border: 1px solid #374151;
            border-radius: 1rem;
        }

        .text-yellow-custom { color: #eab308; }

        .btn-yellow-custom {
            background-color: #ca8a04;
            color: white;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-yellow-custom:hover {
            background-color: #a16207;
            color: white;
            transform: translateY(-1px);
        }

        .bg-green-soft {
            background-color: rgba(22, 101, 52, 0.3);
            border-color: #166534;
        }

        .bg-red-soft {
            background-color: rgba(153, 27, 27, 0.3);
            border-color: #991b1b;
        }

        .tracking-widest { letter-spacing: 0.08em; }

        .ai-summary-box {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 1.25rem;
            color: #d1d5db;
        }

        .custom-badge-hover:hover {
            background-color: #ca8a04 !important;
            color: #121826 !important;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/bam-personal.css') }}?v=1">
</head>
<body class="bam-page">

{% include 'partials/_dashboard_header.html.twig' %}

<main class="py-4 py-lg-5">
    <div class="container bam-shell">
        <section class="bam-card p-4 mb-4">
            <div class="bam-section-head mb-4">
                <div>
                    <div class="bam-eyebrow">Kisisel terminal</div>
                    <h1 class="bam-title h2 mb-1">Hisse Analiz Merkezi</h1>
                    <div class="bam-muted small">
                        {% if app.user %}
                            {{ app.user.email }}
                        {% else %}
                            BAM karar ekrani
                        {% endif %}
                    </div>
                </div>

                <div class="d-flex gap-2">
                    {% if app.user %}
                        <a href="{{ path('app_watchlist') }}" class="btn bam-action-link btn-sm px-3" title="Takip listesi">
                            <i class="bi bi-radar"></i>
                        </a>
                        <a href="{{ path('app_portfolio') }}" class="btn bam-action-link btn-sm px-3" title="Portfoy">
                            <i class="bi bi-briefcase"></i>
                        </a>
                    {% endif %}
                </div>
            </div>

            <form method="get" class="d-flex flex-column flex-md-row gap-2 m-0">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text bg-transparent border-0 text-yellow-custom px-3">
                        <i class="bi bi-search fs-5"></i>
                    </span>
                    <input type="text"
                           name="symbol"
                           value="{{ symbol|default('') }}"
                           class="form-control bam-form-control text-uppercase fw-bold tracking-widest fs-5 shadow-none"
                           placeholder="ASELS, THYAO, SASA"
                           required>
                </div>
                <button type="submit" class="btn btn-yellow-custom fw-bold px-4 py-3 tracking-widest">
                    <i class="bi bi-cpu me-1"></i> ANALIZ ET
                </button>
            </form>
        </section>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5 px-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <i class="bi bi-clock-history text-secondary"></i>
                <span class="text-secondary small fw-bold tracking-widest">SON ARANANLAR:</span>
                <div id="sonArananlarList" class="d-flex flex-wrap gap-2"></div>
            </div>
            <button onclick="temizleSonArananlar()" class="btn btn-sm btn-link text-secondary text-decoration-none p-0">
                Temizle
            </button>
        </div>

        {% if stock is defined and stock is not null %}
            {% set degisim = stock.price - stock.previousClose %}
            {% set yuzde = stock.previousClose > 0 ? (degisim / stock.previousClose) * 100 : 0 %}
            {% set text_renk = degisim >= 0 ? 'text-success' : 'text-danger' %}
            {% set card_bg = degisim >= 0 ? 'bg-green-soft' : 'bg-red-soft' %}
            {% set ikon = degisim >= 0 ? '▲' : '▼' %}

            <div class="card-custom shadow-lg overflow-hidden mb-4 border-0">
                <div class="p-4 border-bottom border-secondary d-flex flex-column flex-md-row justify-content-between align-items-md-center {{ card_bg }}">
                    <div class="mb-3 mb-md-0">
                        <h1 class="display-3 fw-bolder mb-0 tracking-widest text-white">{{ stock.symbol|upper }}</h1>
                        <small class="text-secondary font-monospace">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            SON GUNCELLEME: {{ stock.createdAt|date('d.m.Y H:i:s') }}
                        </small>
                        {% if marketDataStatus is defined and marketDataStatus %}
                            {% if marketDataStatus.isStale %}
                                <div class="mt-2">
                                    <span class="badge text-bg-warning">
                                        {% if marketDataStatus.httpStatus == 429 %}!429 · {% endif %}
                                        STALE VERI · {{ marketDataStatus.source }}
                                    </span>
                                </div>
                            {% else %}
                                <div class="mt-2">
                                    <span class="badge text-bg-success">GUNCEL · {{ marketDataStatus.source }}</span>
                                </div>
                            {% endif %}
                        {% endif %}
                    </div>
                    <div class="text-md-end">
                        <div class="display-5 font-monospace fw-bold text-white">
                            {{ stock.price|number_format(2, ',', '.') }}
                            <span class="fs-4 text-secondary">TL</span>
                        </div>
                        <div class="fs-5 fw-bold {{ text_renk }} d-flex justify-content-md-end align-items-center gap-2 mt-1">
                            <span>{{ ikon }}</span>
                            <span>{{ degisim|number_format(2, ',', '.') }}</span>
                            <span class="badge bg-dark text-light border border-secondary rounded-pill px-3 py-2">
                                %{{ yuzde|abs|number_format(2, ',', '.') }}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="row g-0 border-bottom border-secondary" style="background-color: #374151;">
                    <div class="col-6 col-md-3 p-3 text-center border-end border-bottom border-md-bottom-0 border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">ACILIS</small>
                        <span class="fs-5 fw-bold font-monospace text-light">{{ stock.open|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-end-md border-bottom border-md-bottom-0 border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">GUN YUKSEGI</small>
                        <span class="fs-5 fw-bold font-monospace text-success">{{ stock.high|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-end border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">GUN DUSUGU</small>
                        <span class="fs-5 fw-bold font-monospace text-danger">{{ stock.low|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">ONC. KAPANIS</small>
                        <span class="fs-5 fw-bold font-monospace text-light">{{ stock.previousClose|number_format(2, ',', '.') }}</span>
                    </div>
                </div>

                <div class="p-4 d-flex justify-content-between align-items-center bg-dark bg-opacity-50">
                    <span class="text-secondary small fw-bold tracking-widest">
                        <i class="bi bi-bar-chart-line me-2"></i>TOPLAM HACIM
                    </span>
                    <span class="fs-4 font-monospace fw-bold text-light">{{ stock.volume|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="text-center mt-5">
                <button onclick="toggleNewsList()" class="btn btn-outline-warning rounded-pill px-5 py-3 fw-bold shadow-sm tracking-widest">
                    <i id="arrowIcon" class="bi bi-chevron-down me-2"></i> KAP HABERLERI VE AI ANALIZLERI
                </button>

                <div id="newsListContainer" class="d-none mt-4 text-start">
                    {% if newsList is defined and newsList is not empty %}
                        <div class="row g-4">
                            {% for news in newsList %}
                                {% set isAnalyzed = news.isAnalyzed and news.sentimentScore is not null %}
                                <div class="col-12">
                                    <div class="card-custom p-4 shadow-sm border-start border-4 {{ isAnalyzed ? (news.sentimentScore >= 70 ? 'border-success' : (news.sentimentScore <= -70 ? 'border-danger' : 'border-warning')) : 'border-secondary' }}">
                                        <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                                            <div>
                                                {% if isAnalyzed %}
                                                    <div class="d-flex align-items-center gap-2 mb-1">
                                                        <span class="small text-secondary fw-bold tracking-widest">DUYGU PUANI:</span>
                                                        <span class="fs-5 fw-bold {{ news.sentimentScore >= 70 ? 'text-success' : (news.sentimentScore <= -70 ? 'text-danger' : 'text-warning') }}">
                                                            {{ news.sentimentScore }} / 100
                                                        </span>
                                                    </div>
                                                {% else %}
                                                    <div class="small text-secondary fw-bold tracking-widest mb-1">
                                                        <i class="bi bi-hourglass-split me-1"></i> AI ANALIZI BEKLIYOR
                                                    </div>
                                                {% endif %}
                                                <div class="small text-secondary">
                                                    <i class="bi bi-calendar3 me-1"></i> {{ news.publishedAt|date('d.m.Y H:i') }}
                                                </div>
                                            </div>
                                            <a href="https://www.kap.org.tr/tr/Bildirim/{{ news.kapId }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                KAP'ta Gor <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        </div>
                                        <h5 class="text-light mb-3">{{ news.title }}</h5>
                                        <div class="ai-summary-box small lh-lg">
                                            <i class="bi {{ isAnalyzed ? 'bi-robot text-yellow-custom' : 'bi-building text-secondary' }} me-2 fs-5"></i>
                                            {{ (isAnalyzed ? news.aiSummary : news.content)|nl2br }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="card-custom text-secondary p-5 text-center border-secondary">
                            <i class="bi bi-inbox fs-1 mb-3 d-block opacity-50"></i>
                            <p class="mb-0 fs-5">"{{ symbol }}" icin son 1 haftaya ait KAP haberi bulunamadi.</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% elseif symbol is defined and symbol is not empty %}
            <div class="alert alert-danger bg-red-soft border-danger text-danger text-center rounded-4 p-5 shadow-lg mt-4">
                <i class="bi bi-exclamation-triangle-fill display-4 mb-3 d-block"></i>
                <h4 class="fw-bold mb-2">Veri Bulunamadi</h4>
                <p class="mb-0 text-white-50">
                    {{ marketDataStatus.message|default('"' ~ symbol ~ '" sembolu icin veritabaninda veya Yahoo Finance uzerinde veri bulunamadi.') }}
                </p>
            </div>
        {% endif %}
    </div>
</main>

<footer class="py-4 border-top border-secondary text-center mt-auto" style="background-color: #1f2937;">
    <div class="container text-secondary small tracking-widest">
        <p class="mb-2">&copy; {{ 'now'|date('Y') }} Borsa Analiz Motoru (BAM). Tum haklari saklidir.</p>
        <p class="mb-0 opacity-75" style="font-size: 0.8rem;">
            BAM Terminal bir yatirim danismanligi hizmeti degildir, sunulan analizler yatirim tavsiyesi niteligi tasimaz.<br>
            Lutfen detayli bilgi icin <a href="/yasal-uyari" class="text-warning text-decoration-none">Yasal Uyari</a> metnimizi okuyun.
        </p>
    </div>
</footer>

<div class="position-fixed bottom-0 end-0 p-4">
    <button onclick="localStorageTemizle()" class="btn btn-outline-danger btn-sm rounded-pill shadow-lg px-3 py-2">
        <i class="bi bi-trash3 me-1"></i> Gecmisi Sil
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        sonArananlariGoster();
    });

    let symbol = "{{ symbol|default('') }}";

    if (symbol && symbol.trim() !== '') {
        symbol = symbol.toUpperCase().trim();

        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];

        if (!arananlar.includes(symbol)) {
            arananlar.unshift(symbol);
            if (arananlar.length > 10) {
                arananlar.pop();
            }
            localStorage.setItem('arananSymbolList', JSON.stringify(arananlar));
        }
    }

    function sonArananlariGoster() {
        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];
        let listeHtml = document.getElementById('sonArananlarList');

        if (!listeHtml) {
            return;
        }

        if (arananlar.length === 0) {
            listeHtml.innerHTML = '<span class="text-secondary small opacity-50">Henuz aranan hisse yok</span>';
            return;
        }

        listeHtml.innerHTML = arananlar.map(symbol =>
            `<a href="?symbol=${symbol}" class="badge bg-dark border border-secondary text-secondary text-decoration-none px-3 py-2 rounded-pill custom-badge-hover transition-all">
                ${symbol}
            </a>`
        ).join('');
    }

    function temizleSonArananlar() {
        localStorage.removeItem('arananSymbolList');
        sonArananlariGoster();
    }

    function localStorageTemizle() {
        if (confirm('Tum arama gecmisinizi temizlemek istediginize emin misiniz?')) {
            localStorage.clear();
            sonArananlariGoster();
        }
    }

    function toggleNewsList() {
        const container = document.getElementById('newsListContainer');
        const arrow = document.getElementById('arrowIcon');

        if (!container || !arrow) {
            return;
        }

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            arrow.classList.replace('bi-chevron-down', 'bi-chevron-up');
        } else {
            container.classList.add('d-none');
            arrow.classList.replace('bi-chevron-up', 'bi-chevron-down');
        }
    }
</script>
</body>
</html>
