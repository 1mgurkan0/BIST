<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}BAM (Borsa Analiz Motoru) ile Borsa İstanbul (BIST) hisselerini yapay zeka ve algoritmik sistemlerle analiz edin, fırsatları yakalayın.{% endblock %}">
    <meta name="robots" content="{% block robots %}index, follow{% endblock %}">
    <link rel="canonical" href="https://www.bamterminal.com.tr{{ app.request.pathInfo }}">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="https://www.bamterminal.com.tr{{ app.request.pathInfo }}">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://www.bamterminal.com.tr/images/og-image.png">
    
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ block('title') }}">
    <meta name="twitter:description" content="{{ block('meta_description') }}">
    <meta name="twitter:image" content="https://www.bamterminal.com.tr/images/og-image.png">
    
    <title>{% block title %}BAM - Borsa Analiz Motoru{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <style>
        body {
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background-color: #121826;
            color: #f3f4f6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main { flex: 1; }

        .card-custom {
            background-color: #1f2937;
            border: 1px solid #374151;
            border-radius: 1rem;
        }

        .text-yellow-custom { color: #eab308; }

        .btn-yellow-custom {
            background-color: #ca8a04;
            color: white;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-yellow-custom:hover {
            background-color: #a16207;
            color: white;
            transform: translateY(-1px);
        }

        .bg-green-soft {
            background-color: rgba(22, 101, 52, 0.3);
            border-color: #166534;
        }

        .bg-red-soft {
            background-color: rgba(153, 27, 27, 0.3);
            border-color: #991b1b;
        }

        .tracking-widest { letter-spacing: 0.08em; }

        .ai-summary-box {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 1.25rem;
            color: #d1d5db;
        }

        .custom-badge-hover:hover {
            background-color: #ca8a04 !important;
            color: #121826 !important;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/bam-personal.css') }}?v=1">
</head>
<body class="bam-page">

{% include 'partials/_dashboard_header.html.twig' %}

<main class="py-4 py-lg-5">
    {% block content %}{% endblock %}
</main>

<footer class="py-4 border-top border-secondary text-center mt-auto" style="background-color: #1f2937;">
    <div class="container text-secondary small tracking-widest">
        <p class="mb-2">&copy; {{ 'now'|date('Y') }} Borsa Analiz Motoru (BAM). Tum haklari saklidir.</p>
        <p class="mb-0 opacity-75" style="font-size: 0.8rem;">
            BAM Terminal bir yatirim danismanligi hizmeti degildir, sunulan analizler yatirim tavsiyesi niteligi tasimaz.<br>
            Lutfen detayli bilgi icin <a href="/yasal-uyari" class="text-warning text-decoration-none">Yasal Uyari</a> metnimizi okuyun.
        </p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        sonArananlariGoster();
    });

    let symbol = "{{ symbol|default('') }}";

    if (symbol && symbol.trim() !== '') {
        symbol = symbol.toUpperCase().trim();

        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];

        if (!arananlar.includes(symbol)) {
            arananlar.unshift(symbol);
            if (arananlar.length > 10) {
                arananlar.pop();
            }
            localStorage.setItem('arananSymbolList', JSON.stringify(arananlar));
        }
    }

    function sonArananlariGoster() {
        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];
        let listeHtml = document.getElementById('sonArananlarList');

        if (!listeHtml) {
            return;
        }

        if (arananlar.length === 0) {
            listeHtml.innerHTML = '<span class="text-secondary small opacity-50">Henuz aranan hisse yok</span>';
            return;
        }

        listeHtml.innerHTML = arananlar.map(symbol =>
            `<a href="?symbol=${symbol}" class="badge bg-dark border border-secondary text-secondary text-decoration-none px-3 py-2 rounded-pill custom-badge-hover transition-all">
                ${symbol}
            </a>`
        ).join('');
    }

    function temizleSonArananlar() {
        localStorage.removeItem('arananSymbolList');
        sonArananlariGoster();
    }

    function localStorageTemizle() {
        if (confirm('Tum arama gecmisinizi temizlemek istediginize emin misiniz?')) {
            localStorage.clear();
            sonArananlariGoster();
        }
    }

    function toggleNewsList() {
        const container = document.getElementById('newsListContainer');
        const arrow = document.getElementById('arrowIcon');

        if (!container || !arrow) {
            return;
        }

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            arrow.classList.replace('bi-chevron-down', 'bi-chevron-up');
        } else {
            container.classList.add('d-none');
            arrow.classList.replace('bi-chevron-up', 'bi-chevron-down');
        }
    }
</script>
</body>
</html>
