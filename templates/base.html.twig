<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BAM </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #121826;
            color: #f3f4f6;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .navbar-custom {
            background-color: #1f2937;
            border-bottom: 1px solid #374151;
        }
        .card-custom {
            background-color: #1f2937;
            border: 1px solid #374151;
            border-radius: 1rem;
        }
        .text-yellow-custom { color: #eab308; }
        .btn-yellow-custom {
            background-color: #ca8a04;
            color: white;
            border: none;
            transition: all 0.3s ease;
        }
        .btn-yellow-custom:hover {
            background-color: #a16207;
            color: white;
            transform: translateY(-2px);
        }
        .bg-green-soft { background-color: rgba(22, 101, 52, 0.3); border-color: #166534; }
        .bg-red-soft { background-color: rgba(153, 27, 27, 0.3); border-color: #991b1b; }
        .tracking-widest { letter-spacing: 0.1em; }
        .ai-summary-box {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 1.25rem;
            color: #d1d5db;
        }
        .custom-badge-hover:hover {
            background-color: #ca8a04 !important;
            color: #121826 !important;
        }
        main {
            flex: 1;
        }
        .bist30-scroll {
            max-height: 300px;
            overflow-y: auto;
            padding-right: 5px;
        }
        .bist30-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .bist30-scroll::-webkit-scrollbar-track {
            background: #111827;
            border-radius: 4px;
        }
        .bist30-scroll::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        .bist30-scroll::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
        .bist-list-item {
            background-color: #111827;
            transition: all 0.2s ease;
        }
        .bist-list-item:hover {
            background-color: #1f2937;
            border-color: #4b5563 !important;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/bam-personal.css') }}?v=1">
</head>
<body class="bam-page">

{% include 'partials/_dashboard_header.html.twig' %}

<main class="py-4 py-lg-5">
    <div class="container bam-shell">
        <div class="row g-4 align-items-stretch mb-4">
            <div class="col-lg-7">
                <section class="bam-card p-4 h-100">
                    <div class="bam-section-head mb-4">
                        <div>
                            <div class="bam-eyebrow">Kişisel terminal</div>
                            <h1 class="bam-title h2 mb-1">Hisse Analiz Merkezi</h1>
                            <div class="bam-muted small">
                                {% if app.user %}
                                    {{ app.user.email }}
                                {% else %}
                                    BAM karar ekranı
                                {% endif %}
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            {% if app.user %}
                                <a href="{{ path('app_watchlist') }}" class="btn bam-action-link btn-sm px-3">
                                    <i class="bi bi-radar"></i>
                                </a>
                                <a href="{{ path('app_portfolio') }}" class="btn bam-action-link btn-sm px-3">
                                    <i class="bi bi-briefcase"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <form method="get" class="d-flex flex-column flex-md-row gap-2 m-0">
                        <div class="input-group flex-grow-1">
                            <span class="input-group-text bg-transparent border-0 text-yellow-custom px-3">
                                <i class="bi bi-search fs-5"></i>
                            </span>
                            <input type="text" name="symbol" value="{{ symbol|default('') }}"
                                   class="form-control bam-form-control text-uppercase fw-bold tracking-widest fs-5 shadow-none"
                                   placeholder="ASELS, THYAO, SASA" required>
                        </div>
                        <button type="submit" class="btn btn-yellow-custom fw-bold px-4 py-3 tracking-widest">
                            <i class="bi bi-cpu me-1"></i> ANALİZ ET
                        </button>
                    </form>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="bam-card p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2 px-1">
                        <h6 class="text-yellow-custom tracking-widest mb-0 fw-bold">
                            <i class="bi bi-broadcast text-danger me-2"></i>CANLI BIST 30
                        </h6>
                        <small class="text-secondary font-monospace" id="bist30-time">
                            <div class="spinner-grow spinner-grow-sm text-warning" role="status"></div> Bağlanıyor...
                        </small>
                    </div>

                    <div class="bist30-scroll bam-scroll" id="bist30-container">
                        <div class="text-center text-secondary py-4 opacity-50" id="bist30-loading">
                            Yükleniyor...
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-5 px-2">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-secondary"></i>
                <span class="text-secondary small fw-bold tracking-widest">SON ARANANLAR:</span>
                <div id="sonArananlarList" class="d-flex flex-wrap gap-2 ms-2"></div>
            </div>
            <button onclick="temizleSonArananlar()" class="btn btn-sm btn-link text-secondary text-decoration-none p-0">
                Temizle
            </button>
        </div>

        {% if stock is defined and stock is not null %}
            {% set degisim = stock.price - stock.previousClose %}
            {% set yuzde = stock.previousClose > 0 ? (degisim / stock.previousClose) * 100 : 0 %}
            {% set text_renk = degisim >= 0 ? 'text-success' : 'text-danger' %}
            {% set card_bg = degisim >= 0 ? 'bg-green-soft' : 'bg-red-soft' %}
            {% set ikon = degisim >= 0 ? '▲' : '▼' %}

            <div class="card-custom shadow-lg overflow-hidden mb-4 border-0">
                <div class="p-4 border-bottom border-secondary d-flex flex-column flex-md-row justify-content-between align-items-md-center {{ card_bg }}">
                    <div class="mb-3 mb-md-0">
                        <h1 class="display-3 fw-bolder mb-0 tracking-widest text-white">{{ stock.symbol|upper }}</h1>
                        <small class="text-secondary font-monospace"><i class="bi bi-arrow-repeat me-1"></i> SON GÜNCELLEME: {{ stock.createdAt|date('d.m.Y H:i:s') }}</small>
                    </div>
                    <div class="text-md-end">
                        <div class="display-5 font-monospace fw-bold text-white">{{ stock.price|number_format(2, ',', '.') }} <span class="fs-4 text-secondary">₺</span></div>
                        <div class="fs-5 fw-bold {{ text_renk }} d-flex justify-content-md-end align-items-center gap-2 mt-1">
                            <span>{{ ikon }}</span>
                            <span>{{ degisim|number_format(2, ',', '.') }}</span>
                            <span class="badge bg-dark text-light border border-secondary rounded-pill px-3 py-2">%{{ yuzde|abs|number_format(2, ',', '.') }}</span>
                        </div>
                    </div>
                </div>

                <div class="row g-0 border-bottom border-secondary" style="background-color: #374151;">
                    <div class="col-6 col-md-3 p-3 text-center border-end border-bottom border-md-bottom-0 border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">AÇILIŞ</small>
                        <span class="fs-5 fw-bold font-monospace text-light">{{ stock.open|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-end-md border-bottom border-md-bottom-0 border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">GÜN YÜKSEĞİ</small>
                        <span class="fs-5 fw-bold font-monospace text-success">{{ stock.high|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-end border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">GÜN DÜŞÜĞÜ</small>
                        <span class="fs-5 fw-bold font-monospace text-danger">{{ stock.low|number_format(2, ',', '.') }}</span>
                    </div>
                    <div class="col-6 col-md-3 p-3 text-center border-secondary">
                        <small class="text-secondary fw-bold tracking-widest d-block mb-1">ÖNC. KAPANIŞ</small>
                        <span class="fs-5 fw-bold font-monospace text-light">{{ stock.previousClose|number_format(2, ',', '.') }}</span>
                    </div>
                </div>

                <div class="p-4 d-flex justify-content-between align-items-center bg-dark bg-opacity-50">
                    <span class="text-secondary small fw-bold tracking-widest"><i class="bi bi-bar-chart-line me-2"></i>TOPLAM HACİM (LOT)</span>
                    <span class="fs-4 font-monospace fw-bold text-light">{{ stock.volume|number_format(0, ',', '.') }}</span>
                </div>
            </div>

            <div class="text-center mt-5">
                <button onclick="toggleNewsList()" class="btn btn-outline-warning rounded-pill px-5 py-3 fw-bold shadow-sm tracking-widest transition-all">
                    <i id="arrowIcon" class="bi bi-chevron-down me-2"></i> YAPAY ZEKA KAP ANALİZLERİ
                </button>

                <div id="newsListContainer" class="d-none mt-4 text-start">
                    {% if newsList is defined and newsList is not empty %}
                        <div class="row g-4">
                            {% for news in newsList %}
                                <div class="col-12">
                                    <div class="card-custom p-4 shadow-sm border-start border-4 {{ news.sentimentScore >= 70 ? 'border-success' : (news.sentimentScore <= -70 ? 'border-danger' : 'border-warning') }}">
                                        <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-1">
                                                    <span class="small text-secondary fw-bold tracking-widest">DUYGU PUANI:</span>
                                                    <span class="fs-5 fw-bold {{ news.sentimentScore >= 70 ? 'text-success' : (news.sentimentScore <= -70 ? 'text-danger' : 'text-warning') }}">
                                                        {{ news.sentimentScore }} / 100
                                                    </span>
                                                </div>
                                                <div class="small text-secondary"><i class="bi bi-calendar3 me-1"></i> {{ news.publishedAt|date('d.m.Y H:i') }}</div>
                                            </div>
                                            <a href="https://www.kap.org.tr/tr/Bildirim/{{ news.kapId }}" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                KAP'ta Gör <i class="bi bi-box-arrow-up-right ms-1"></i>
                                            </a>
                                        </div>
                                        <div class="ai-summary-box small lh-lg">
                                            <i class="bi bi-robot text-yellow-custom me-2 fs-5"></i>
                                            {{ news.aiSummary|nl2br }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="card-custom text-secondary p-5 text-center border-secondary">
                            <i class="bi bi-inbox fs-1 mb-3 d-block opacity-50"></i>
                            <p class="mb-0 fs-5">"{{ symbol }}" için son 1 haftaya ait KAP haberi veya analizi bulunamadı.</p>
                        </div>
                    {% endif %}
                </div>
            </div>

        {% elseif symbol is defined and symbol is not empty %}
            <div class="alert alert-danger bg-red-soft border-danger text-danger text-center rounded-4 p-5 shadow-lg mt-4">
                <i class="bi bi-exclamation-triangle-fill display-4 mb-3 d-block"></i>
                <h4 class="fw-bold mb-2">Veri Bulunamadı</h4>
                <p class="mb-0 text-white-50">"{{ symbol }}" sembolü için veritabanında veya Yahoo Finance üzerinde kayıtlı güncel bir veri çekilemedi.</p>
            </div>
        {% endif %}
    </div>
</main>

<footer class="py-4 border-top border-secondary text-center mt-auto" style="background-color: #1f2937;">
    <div class="container text-secondary small tracking-widest">
        <p class="mb-1">&copy; {{ 'now'|date('Y') }} Borsa Analiz Motoru (BAM). Tüm hakları saklıdır.</p>
        <p class="mb-0 opacity-50">Yatırım tavsiyesi değildir. Veriler gecikmeli olabilir.</p>
    </div>
</footer>

<div class="position-fixed bottom-0 end-0 p-4">
    <button onclick="localStorageTemizle()" class="btn btn-outline-danger btn-sm rounded-pill shadow-lg px-3 py-2">
        <i class="bi bi-trash3 me-1"></i> Geçmişi Sil
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function fetchBist30Live() {
        fetch('/api/bist30/live')
            .then(response => response.json())
            .then(data => {
                const container = document.getElementById('bist30-container');
                const timeLabel = document.getElementById('bist30-time');

                if (data.status === 'waiting_for_command' || !data.items || Object.keys(data.items).length === 0) {
                    container.innerHTML = `<div class="text-center text-secondary py-3 opacity-50"><i class="bi bi-clock-history mb-2 fs-4 d-block"></i>Piyasa verisi bekleniyor...</div>`;
                    timeLabel.innerHTML = 'Veri Yok';
                    return;
                }

                const timeString = new Date(data.fetchedAt).toLocaleTimeString('tr-TR', { hour: '2-digit', minute:'2-digit', second:'2-digit' });
                timeLabel.innerHTML = `<i class="bi bi-arrow-repeat me-1"></i> Son: ${timeString}`;


                let html = '<div class="d-flex flex-column gap-2">';

                const itemsArray = Array.isArray(data.items) ? data.items : Object.values(data.items);

                itemsArray.forEach(stock => {
                    const isPositive = stock.changePercent >= 0;
                    const textColor = isPositive ? 'text-success' : 'text-danger';
                    const bgColor = isPositive ? 'bg-green-soft border-success' : 'bg-red-soft border-danger';
                    const icon = isPositive ? '▲' : '▼';
                    const formattedPrice = parseFloat(stock.price).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    const formattedChange = Math.abs(parseFloat(stock.changePercent)).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                    html += `
                        <a href="?symbol=${stock.symbol}" class="text-decoration-none">
                            <div class="bist-list-item d-flex justify-content-between align-items-center p-2 rounded border border-secondary shadow-sm">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="fw-bold text-white tracking-widest" style="width: 70px;">${stock.symbol}</span>
                                    <span class="font-monospace text-light fw-bold">${formattedPrice} ₺</span>
                                </div>
                                <div>
                                    <span class="badge ${bgColor} ${textColor} rounded-pill px-2 py-1" style="width: 80px;">
                                        ${icon} %${formattedChange}
                                    </span>
                                </div>
                            </div>
                        </a>
                    `;
                });

                html += '</div>';
                container.innerHTML = html;
            })
            .catch(error => {
                console.error("BIST30 verisi çekilemedi:", error);
                document.getElementById('bist30-time').innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Hata</span>';
            });
    }

    fetchBist30Live();

    setInterval(fetchBist30Live, 30000);
</script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        sonArananlariGoster();
    });

    let symbol = "{{ symbol|default('') }}";

    if (symbol && symbol.trim() !== '') {
        symbol = symbol.toUpperCase().trim();

        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];

        if (!arananlar.includes(symbol)) {
            arananlar.unshift(symbol);
            if (arananlar.length > 10) {
                arananlar.pop();
            }
            localStorage.setItem('arananSymbolList', JSON.stringify(arananlar));
        }
    }

    function sonArananlariGoster() {
        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];
        let listeHtml = document.getElementById('sonArananlarList');

        if (arananlar.length === 0) {
            listeHtml.innerHTML = '<span class="text-secondary small opacity-50">Henüz aranan hisse yok</span>';
            return;
        }

        listeHtml.innerHTML = arananlar.map(symbol =>
            `<a href="?symbol=${symbol}" class="badge bg-dark border border-secondary text-secondary text-decoration-none px-3 py-2 rounded-pill custom-badge-hover transition-all">
                ${symbol}
            </a>`
        ).join('');
    }

    function temizleSonArananlar() {
        localStorage.removeItem('arananSymbolList');
        sonArananlariGoster();
    }

    function localStorageTemizle() {
        if (confirm('Tüm arama geçmişinizi temizlemek istediğinize emin misiniz?')) {
            localStorage.clear();
            sonArananlariGoster();
        }
    }

    function toggleNewsList() {
        const container = document.getElementById('newsListContainer');
        const arrow = document.getElementById('arrowIcon');

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            arrow.classList.replace('bi-chevron-down', 'bi-chevron-up');
        } else {
            container.classList.add('d-none');
            arrow.classList.replace('bi-chevron-up', 'bi-chevron-down');
        }
    }
</script>

</body>
</html>
