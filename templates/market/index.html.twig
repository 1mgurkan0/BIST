{% extends 'base.html.twig' %}

{% block title %}Borsa İstanbul Canlı Fiyatlar - BAM Terminal{% endblock %}
{% block meta_description %}BIST 30, BIST 50 ve BIST 100 hisseleri için canlı fiyatlar, değişim oranları ve anlık borsa verileri.{% endblock %}

{% block content %}
<div class="container bam-shell pt-4">

    <!-- ARAMA MOTORU (ORİJİNAL TASARIM) -->
    <section class="bam-card p-4 mb-5">
        <div class="bam-section-head mb-4">
            <div>
                <div class="bam-eyebrow">Kişisel terminal</div>
                <h1 class="bam-title h2 mb-1">Hisse Analiz Merkezi</h1>
                <div class="bam-muted small">
                    {% if app.user %}
                        {{ app.user.email }}
                    {% else %}
                        BAM karar ekranı
                    {% endif %}
                </div>
            </div>

            <div class="d-flex gap-2">
                {% if app.user %}
                    <a href="{{ path('app_watchlist') }}" class="btn bam-action-link btn-sm px-3" title="Takip listesi">
                        <i class="bi bi-radar"></i>
                    </a>
                    <a href="{{ path('app_portfolio') }}" class="btn bam-action-link btn-sm px-3" title="Portföy">
                        <i class="bi bi-briefcase"></i>
                    </a>
                {% endif %}
            </div>
        </div>

        <form action="{{ path('app_stock_search') }}" method="get" class="d-flex flex-column flex-md-row gap-2 m-0">
            <div class="input-group">
                <span class="input-group-text bg-transparent border-secondary text-secondary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="q" class="form-control form-control-lg bg-dark border-secondary text-light shadow-none" placeholder="Sembol (THYAO vb.)" required>
            </div>
            <button type="submit" class="btn btn-warning px-4 fw-bold">Analiz Et</button>
        </form>
    </section>

    <!-- YERLİ HTML BORSA TABLOLARI -->
    <div class="mt-4 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
            <h2 class="fw-bold text-light mb-0 tracking-widest"><i class="bi bi-bar-chart-line-fill text-warning me-2"></i>BAM CANLI PİYASA</h2>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-secondary"></i>
                <span class="text-secondary small font-monospace">Son Güncelleme: <strong class="text-light">{{ lastUpdate }}</strong></span>
            </div>
        </div>

        <!-- TAB NAVIGASYON -->
        <ul class="nav nav-pills mb-4 gap-2 border-bottom border-secondary pb-3" id="pills-tab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active rounded-pill fw-bold px-4 shadow-sm" id="pills-bist100-tab" data-bs-toggle="pill" data-bs-target="#pills-bist100" type="button" role="tab" aria-controls="pills-bist100" aria-selected="true">
                    BIST 100
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold px-4 shadow-sm text-light" id="pills-bist50-tab" data-bs-toggle="pill" data-bs-target="#pills-bist50" type="button" role="tab" aria-controls="pills-bist50" aria-selected="false">
                    BIST 50
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold px-4 shadow-sm text-light" id="pills-bist30-tab" data-bs-toggle="pill" data-bs-target="#pills-bist30" type="button" role="tab" aria-controls="pills-bist30" aria-selected="false">
                    BIST 30
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link rounded-pill fw-bold px-4 shadow-sm text-warning" id="pills-all-tab" data-bs-toggle="pill" data-bs-target="#pills-all" type="button" role="tab" aria-controls="pills-all" aria-selected="false">
                    Tüm Hisseler (116)
                </button>
            </li>
        </ul>

        <!-- TAB İÇERİKLERİ -->
        <div class="tab-content" id="pills-tabContent">
            
            {% macro renderStockTable(stocks) %}
                {% if stocks is empty %}
                    <div class="text-center p-5 text-secondary">Veri bulunamadı. Lütfen arka planda sistemin çalışmasını bekleyin.</div>
                {% else %}
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        {% set chunk_size = (stocks|length / 3)|round(0, 'ceil') %}
                        {% for column_stocks in stocks|batch(chunk_size) %}
                            <div class="col">
                                <div class="table-responsive rounded-4 shadow-lg border border-secondary" style="background-color: #111827;">
                                    <table class="table table-dark table-hover mb-0 align-middle table-borderless">
                                        <thead class="table-secondary text-dark border-bottom border-dark">
                                            <tr>
                                                <th class="py-3 px-3">Menkul</th>
                                                <th class="py-3 px-3 text-end">Fiyat</th>
                                                <th class="py-3 px-3 text-end">%</th>
                                                <th class="py-3 px-3 text-end">Zaman</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for st in column_stocks %}
                                                {% set degisim = st.price - st.previous_close %}
                                                {% set yuzde = st.previous_close > 0 ? (degisim / st.previous_close) * 100 : 0 %}
                                                {% set text_renk = degisim > 0 ? 'text-success' : (degisim < 0 ? 'text-danger' : 'text-secondary') %}
                                                {% set ikon = degisim > 0 ? '▲' : (degisim < 0 ? '▼' : '▬') %}
                                                
                                                <tr class="border-bottom border-secondary border-opacity-25" style="cursor: pointer;" onclick="window.location='{{ path('app_stock_detail', {'symbol': st.symbol}) }}'">
                                                    <td class="py-2 px-3 fw-bold text-light">
                                                        {{ st.symbol }}
                                                    </td>
                                                    <td class="py-2 px-3 text-end fw-bold font-monospace {{ text_renk }}">
                                                        {{ st.price|number_format(2, ',', '.') }}
                                                    </td>
                                                    <td class="py-2 px-3 text-end fw-bold {{ text_renk }}">
                                                        <span class="small me-1">{{ ikon }}</span>{{ yuzde|abs|number_format(2, ',', '.') }}
                                                    </td>
                                                    <td class="py-2 px-3 text-end text-secondary small font-monospace">
                                                        {{ st.updated_at|date('H:i:s') }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endmacro %}

            <div class="tab-pane fade show active" id="pills-bist100" role="tabpanel" aria-labelledby="pills-bist100-tab">
                {{ _self.renderStockTable(marketStocks.bist100) }}
            </div>
            <div class="tab-pane fade" id="pills-bist50" role="tabpanel" aria-labelledby="pills-bist50-tab">
                {{ _self.renderStockTable(marketStocks.bist50) }}
            </div>
            <div class="tab-pane fade" id="pills-bist30" role="tabpanel" aria-labelledby="pills-bist30-tab">
                {{ _self.renderStockTable(marketStocks.bist30) }}
            </div>
            <div class="tab-pane fade" id="pills-all" role="tabpanel" aria-labelledby="pills-all-tab">
                {{ _self.renderStockTable(marketStocks.all) }}
            </div>
        </div>
        
    </div>

</div>
{% endblock %}
