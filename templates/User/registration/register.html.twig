{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <title>BAM | Kayıt</title>
    <style>
        body {
            background-color: #0b0c10;
            font-family: 'Outfit', sans-serif;
            color: #e2e8f0;
            margin: 0;
        }
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            position: relative;
        }
        .auth-container::before {
            content: '';
            position: absolute;
            top: -20%; right: -10%;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(234, 179, 8, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .auth-wrapper {
            background: #121318;
            border: 1px solid #1f2129;
            border-radius: 24px;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 1050px;
            display: flex;
            overflow: hidden;
            position: relative;
            z-index: 10;
        }
        .auth-brand {
            background: linear-gradient(145deg, #171821 0%, #0b0c10 100%);
            border-right: 1px solid #1f2129;
            padding: 4rem;
            width: 45%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }
        .auth-brand::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(234, 179, 8, 0.15) 1px, transparent 1px);
            background-size: 32px 32px;
            opacity: 0.3;
            pointer-events: none;
        }
        .auth-form-side {
            padding: 4rem;
            width: 55%;
            background: #121318;
        }
        .logo-box {
            width: 64px; height: 64px;
            background: #000;
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            font-size: 32px; font-weight: 800; color: #0b0c10;
            margin-bottom: 2rem;
            box-shadow: 0 12px 24px -6px rgba(234, 179, 8, 0.4);
            position: relative;
            z-index: 2;
        }
        .brand-title {
            font-size: 2.75rem; font-weight: 800; color: #ffffff;
            line-height: 1.1; margin-bottom: 1rem; position: relative; z-index: 2;
        }
        .brand-title span { color: #eab308; }
        .brand-text {
            color: #94a3b8; font-size: 1.1rem; line-height: 1.7;
            position: relative; z-index: 2;
        }
        .form-title { font-size: 1.8rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem; }
        .form-subtitle { color: #64748b; font-size: 1rem; margin-bottom: 2.5rem; }

        .input-group-custom { margin-bottom: 1.5rem; }
        .input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
        .label-custom {
            display: block; font-size: 0.75rem; font-weight: 700;
            color: #94a3b8; letter-spacing: 1.2px; margin-bottom: 0.5rem; text-transform: uppercase;
        }
        .field-custom {
            width: 100%; background: #0b0c10; border: 1px solid #232530;
            border-radius: 12px; padding: 0.9rem 1.25rem;
            color: #f8fafc; font-size: 1rem; font-family: 'Outfit', sans-serif;
            transition: all 0.2s ease;
        }
        .field-custom:focus {
            outline: none; border-color: #eab308;
            box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.1);
            background: #101116;
        }
        .field-custom.is-invalid {
            border-color: #ef4444; box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.1);
        }
        .error-text { color: #ef4444; font-size: 0.8rem; margin-top: 0.5rem; display: block; font-weight: 500; }

        .pwd-strength-container { margin-top: 0.75rem; }
        .pwd-bars { display: flex; gap: 6px; height: 4px; margin-bottom: 0.5rem; }
        .pwd-bar { flex: 1; background: #232530; border-radius: 4px; transition: all 0.3s ease; }
        .pwd-status { font-size: 0.75rem; color: #64748b; font-weight: 600; text-align: right; text-transform: uppercase; letter-spacing: 0.5px; }

        .check-custom { display: flex; align-items: flex-start; gap: 0.75rem; margin-top: 2rem; margin-bottom: 2rem; }
        .check-custom input {
            appearance: none; width: 22px; height: 22px; min-width: 22px;
            border: 1px solid #333645; border-radius: 6px;
            background: #0b0c10; cursor: pointer; position: relative;
            margin-top: 2px; transition: all 0.2s;
        }
        .check-custom input:focus { box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.1); border-color: #eab308; outline: none; }
        .check-custom input:checked { background: #eab308; border-color: #eab308; }
        .check-custom input:checked::after {
            content: '✓'; position: absolute; top: 50%; left: 50%;
            transform: translate(-50%, -50%); color: #0b0c10; font-size: 14px; font-weight: 900;
        }
        .check-custom label { font-size: 0.95rem; color: #94a3b8; cursor: pointer; line-height: 1.5; }
        .check-custom label a { color: #eab308; text-decoration: none; font-weight: 500; }
        .check-custom label a:hover { text-decoration: underline; }

        .btn-custom {
            background: #eab308; color: #0b0c10;
            border: none; border-radius: 12px;
            padding: 1.1rem; font-size: 1.1rem; font-weight: 700;
            width: 100%; cursor: pointer; transition: all 0.3s ease;
            box-shadow: 0 8px 20px -6px rgba(234, 179, 8, 0.4);
            display: flex; justify-content: center; align-items: center; gap: 0.5rem;
            letter-spacing: 0.5px;
        }
        .btn-custom:hover { background: #facc15; transform: translateY(-2px); box-shadow: 0 12px 25px -6px rgba(234, 179, 8, 0.5); }
        .btn-custom:active { transform: translateY(0); }

        .bottom-link { text-align: center; margin-top: 2.5rem; font-size: 1rem; color: #64748b; border-top: 1px solid #1f2129; padding-top: 2rem;}
        .bottom-link a { color: #ffffff; font-weight: 700; text-decoration: none; transition: color 0.2s; margin-left: 0.5rem;}
        .bottom-link a:hover { color: #eab308; }

        .flash-alert {
            padding: 1rem 1.25rem; border-radius: 12px; font-size: 0.9rem; font-weight: 500; margin-bottom: 2rem;
            display: flex; align-items: center; gap: 0.75rem;
        }
        .flash-error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; }
        .flash-success { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); color: #22c55e; }
        .flash-warning { background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.2); color: #eab308; }
        @media (max-width: 992px) {
            .auth-wrapper { flex-direction: column; max-width: 550px; }
            .auth-brand { width: 100%; padding: 3rem; text-align: center; align-items: center; border-right: none; border-bottom: 1px solid #1f2129; }
            .auth-form-side { width: 100%; padding: 3rem; }
            .brand-title { font-size: 2.25rem; }
        }
        @media (max-width: 576px) {
            .auth-form-side, .auth-brand { padding: 2rem; }
            .input-row { grid-template-columns: 1fr; gap: 0; }
            .input-group-custom { margin-bottom: 1.25rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-container">
        <div class="auth-wrapper">

            <div class="auth-brand">
                <div class="logo-box">
                    <a href="{{path('app-home')}}"><img src="{{ asset('images/logo/bam-images.png') }}" alt="BAM Logo" width="120" height="100"></a>
                </div>
                <h1 class="brand-title">BAM <span>Sistem</span></h1>
                <p class="brand-text">Yapay zeka destekli borsa analiz motoru ile portföyünüzü en üst seviyeye taşıyın. Verinin gücünü keşfedin.</p>
            </div>

            <div class="auth-form-side">
                <h2 class="form-title">Hesap Oluştur</h2>
                <p class="form-subtitle">Tüm özelliklere erişmek için ücretsiz kayıt olun.</p>

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash-alert flash-{{ type == 'error' or type == 'danger' ? 'error' : (type == 'warning' ? 'warning' : 'success') }}">
                            <i class="bi bi-{{ type == 'error' or type == 'danger' ? 'exclamation-triangle' : (type == 'warning' ? 'exclamation-circle' : 'check-circle') }}-fill"></i>
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="input-row">
                    <div class="input-group-custom">
                        {{ form_label(registrationForm.firstName, 'AD', {'label_attr': {'class': 'label-custom'}}) }}
                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'field-custom' ~ (registrationForm.firstName.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Adınız'}}) }}
                        <div class="error-text">{{ form_errors(registrationForm.firstName) }}</div>
                    </div>

                    <div class="input-group-custom">
                        {{ form_label(registrationForm.lastName, 'SOYAD', {'label_attr': {'class': 'label-custom'}}) }}
                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'field-custom' ~ (registrationForm.lastName.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Soyadınız'}}) }}
                        <div class="error-text">{{ form_errors(registrationForm.lastName) }}</div>
                    </div>
                </div>

                <div class="input-group-custom">
                    {{ form_label(registrationForm.email, 'E-POSTA ADRESİ', {'label_attr': {'class': 'label-custom'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'field-custom' ~ (registrationForm.email.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'ornek@mail.com'}}) }}
                    <div class="error-text">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div class="input-row">
                    <div class="input-group-custom">
                        {{ form_label(registrationForm.plainPassword.first, 'ŞİFRE', {'label_attr': {'class': 'label-custom'}}) }}
                        {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'field-custom password-input' ~ (registrationForm.plainPassword.first.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': '••••••••'}}) }}

                        <div class="pwd-strength-container">
                            <div class="pwd-bars">
                                <div class="pwd-bar" id="bar-1"></div>
                                <div class="pwd-bar" id="bar-2"></div>
                                <div class="pwd-bar" id="bar-3"></div>
                                <div class="pwd-bar" id="bar-4"></div>
                            </div>
                            <div id="pwd-text" class="pwd-status">Şifre Girin</div>
                        </div>

                        <div class="error-text">{{ form_errors(registrationForm.plainPassword.first) }}</div>
                    </div>

                    <div class="input-group-custom">
                        {{ form_label(registrationForm.plainPassword.second, 'ŞİFRE TEKRAR', {'label_attr': {'class': 'label-custom'}}) }}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'field-custom' ~ (registrationForm.plainPassword.second.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': '••••••••'}}) }}
                        <div class="error-text">{{ form_errors(registrationForm.plainPassword.second) }}</div>
                    </div>
                </div>

                <div class="check-custom">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms, 'Kullanıcı sözleşmesini ve gizlilik politikasını okudum, kabul ediyorum.', {'label_attr': {}}) }}
                </div>
                <div class="error-text mt-[-1rem] mb-3">{{ form_errors(registrationForm.agreeTerms) }}</div>

                <button type="submit" class="btn-custom">
                    HESAP OLUŞTUR <i class="bi bi-arrow-right"></i>
                </button>

                {{ form_end(registrationForm) }}

                <div class="bottom-link">
                    Zaten bir hesabınız var mı? <a href="{{ path('app_login') }}">Giriş Yap</a>
                </div>

            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const input = document.querySelector('.password-input');
            const b1 = document.getElementById('bar-1');
            const b2 = document.getElementById('bar-2');
            const b3 = document.getElementById('bar-3');
            const b4 = document.getElementById('bar-4');
            const text = document.getElementById('pwd-text');

            function score(pw) {
                if (!pw) return 0;
                let s = 0;
                if (pw.length >= 6) s++;
                if (pw.length >= 10) s++;
                if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) s++;
                if (/\d/.test(pw) && /[^A-Za-z0-9]/.test(pw)) s++;
                return Math.min(s, 4);
            }

            if(input) {
                input.addEventListener('input', () => {
                    const val = score(input.value);

                    // Reset colors
                    [b1, b2, b3, b4].forEach(b => b.style.backgroundColor = '#232530');
                    text.style.color = '#64748b';

                    if(val === 0 && input.value.length > 0) {
                        b1.style.backgroundColor = '#ef4444';
                        text.textContent = 'ÇOK ZAYIF'; text.style.color = '#ef4444';
                    } else if(val === 1) {
                        b1.style.backgroundColor = '#ef4444';
                        text.textContent = 'ZAYIF'; text.style.color = '#ef4444';
                    } else if(val === 2) {
                        b1.style.backgroundColor = '#f97316';
                        b2.style.backgroundColor = '#f97316';
                        text.textContent = 'ORTA'; text.style.color = '#f97316';
                    } else if(val === 3) {
                        b1.style.backgroundColor = '#eab308';
                        b2.style.backgroundColor = '#eab308';
                        b3.style.backgroundColor = '#eab308';
                        text.textContent = 'GÜÇLÜ'; text.style.color = '#eab308';
                    } else if(val === 4) {
                        b1.style.backgroundColor = '#22c55e';
                        b2.style.backgroundColor = '#22c55e';
                        b3.style.backgroundColor = '#22c55e';
                        b4.style.backgroundColor = '#22c55e';
                        text.textContent = 'ÇOK GÜÇLÜ'; text.style.color = '#22c55e';
                    } else {
                        text.textContent = 'ŞİFRE GİRİN';
                    }
                });
            }
        });
    </script>
{% endblock %}