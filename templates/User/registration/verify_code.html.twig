{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <title>BAM | Email-doğrulama</title>
    <style>
        body {
            background-color: #0b0c10;
            font-family: 'Outfit', sans-serif;
            color: #e2e8f0;
            margin: 0;
        }
        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            position: relative;
        }
        .auth-container::before {
            content: '';
            position: absolute;
            top: -20%; right: -10%;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(234, 179, 8, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .auth-wrapper {
            background: #121318;
            border: 1px solid #1f2129;
            border-radius: 24px;
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 500px;
            padding: 3.5rem 3rem;
            position: relative;
            z-index: 10;
            text-align: center;
        }
        .logo-box {
            width: 64px; height: 64px;
            background: #eab308;
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            font-size: 32px; font-weight: 800; color: #0b0c10;
            margin: 0 auto 2rem auto;
            box-shadow: 0 12px 24px -6px rgba(234, 179, 8, 0.4);
        }
        .form-title { font-size: 1.8rem; font-weight: 700; color: #ffffff; margin-bottom: 0.5rem; }
        .form-subtitle { color: #94a3b8; font-size: 1rem; margin-bottom: 2rem; line-height: 1.6; }
        .form-subtitle strong { color: #eab308; }

        .flash-alert {
            padding: 1rem 1.25rem; border-radius: 12px; font-size: 0.9rem; font-weight: 500; margin-bottom: 1.5rem;
            display: flex; align-items: center; gap: 0.75rem; text-align: left;
        }
        .flash-error   { background: rgba(239, 68, 68, 0.1);  border: 1px solid rgba(239, 68, 68, 0.2);  color: #ef4444; }
        .flash-success { background: rgba(34, 197, 94, 0.1);  border: 1px solid rgba(34, 197, 94, 0.2);  color: #22c55e; }
        .flash-warning { background: rgba(234, 179, 8, 0.1);  border: 1px solid rgba(234, 179, 8, 0.2);  color: #eab308; }

        .otp-group {
            display: flex; gap: 0.75rem; justify-content: center;
            margin: 2rem 0;
        }
        .otp-input {
            width: 52px; height: 64px;
            background: #0b0c10;
            border: 2px solid #232530;
            border-radius: 12px;
            color: #eab308;
            font-family: 'Outfit', sans-serif;
            font-size: 1.75rem; font-weight: 700;
            text-align: center;
            outline: none;
            transition: all 0.2s ease;
            -webkit-appearance: none;
            caret-color: #eab308;
        }
        .otp-input:focus {
            border-color: #eab308;
            box-shadow: 0 0 0 4px rgba(234, 179, 8, 0.15);
            background: #101116;
        }
        .otp-input.filled {
            border-color: rgba(234, 179, 8, 0.6);
            background: #101116;
        }
        .otp-input.error {
            border-color: #ef4444;
            background: rgba(239, 68, 68, 0.05);
        }
        .otp-input:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .timer-wrap {
            text-align: center; margin-bottom: 2rem;
            font-size: 0.9rem; color: #64748b; font-weight: 500;
            line-height: 1.6;
        }
        .timer-wrap span { color: #ffffff; font-weight: 700; letter-spacing: 1px; }

        .btn-custom {
            background: #eab308; color: #0b0c10;
            border: none; border-radius: 12px;
            padding: 1.1rem; font-size: 1.1rem; font-weight: 700;
            width: 100%; cursor: pointer; transition: all 0.3s ease;
            box-shadow: 0 8px 20px -6px rgba(234, 179, 8, 0.4);
            letter-spacing: 0.5px;
        }
        .btn-custom:hover:not(:disabled) { background: #facc15; transform: translateY(-2px); box-shadow: 0 12px 25px -6px rgba(234, 179, 8, 0.5); }
        .btn-custom:active:not(:disabled) { transform: translateY(0); }
        .btn-custom:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

        .btn-resend {
            background: transparent; color: #94a3b8;
            border: 1px solid #232530; border-radius: 10px;
            padding: 0.75rem 1.5rem; font-size: 0.9rem; font-weight: 500;
            cursor: pointer; transition: all 0.2s ease; font-family: 'Outfit', sans-serif;
            margin-top: 1.5rem; width: 100%;
        }
        .btn-resend:hover { border-color: #eab308; color: #eab308; background: rgba(234, 179, 8, 0.05); }

        .bottom-link { text-align: center; margin-top: 2rem; font-size: 0.9rem; border-top: 1px solid #1f2129; padding-top: 1.5rem; }
        .bottom-link a { color: #eab308; font-weight: 600; text-decoration: none; transition: color 0.2s; }
        .bottom-link a:hover { opacity: 0.8; }

        @media (max-width: 450px) {
            .auth-wrapper { padding: 2.5rem 1.5rem; }
            .otp-input { width: 44px; height: 56px; font-size: 1.5rem; }
            .otp-group { gap: 0.5rem; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-container">
        <div class="auth-wrapper">

            <div class="logo-box"><i class="bi bi-shield-lock-fill"></i></div>
            <h2 class="form-title">Kodu Doğrula</h2>
            <p class="form-subtitle">
                <strong>{{ email }}</strong> adresine gönderilen<br>6 haneli doğrulama kodunu girin.
            </p>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-alert flash-{{ type == 'error' or type == 'danger' ? 'error' : (type == 'warning' ? 'warning' : 'success') }}">
                        <i class="bi bi-{{ type == 'error' or type == 'danger' ? 'exclamation-triangle' : (type == 'warning' ? 'exclamation-circle' : 'check-circle') }}-fill"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% if isBlocked %}
                <div class="flash-alert flash-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Çok fazla yanlış deneme yaptınız. Lütfen yeni kod isteyin.
                </div>
            {% else %}
                <form method="post" action="{{ path('app_verify_code') }}" id="otp-form">

                    <div class="otp-group" id="otp-group">
                        {% for i in 1..6 %}
                            <input
                                    class="otp-input"
                                    type="text"
                                    name="digit[]"
                                    maxlength="1"
                                    inputmode="numeric"
                                    pattern="[0-9]"
                                    autocomplete="{% if i == 1 %}one-time-code{% else %}off{% endif %}"
                                    data-index="{{ i - 1 }}"
                                    required
                            >
                        {% endfor %}
                    </div>

                    {% if expiresAt %}
                        <div class="timer-wrap" id="timer-wrap">
                            Kodunuz <span id="timer">02:00</span> içinde geçersiz olacak
                        </div>
                    {% endif %}

                    <button type="submit" class="btn-custom" id="submit-btn">
                        DOĞRULA <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>
            {% endif %}

            <form method="post" action="{{ path('app_resend_code') }}" id="resend-form">
                <button type="submit" class="btn-resend">
                    <i class="bi bi-arrow-clockwise me-1"></i> Yeni Kod Gönder
                </button>
            </form>

            <div class="bottom-link">
                <a href="{{ path('app_register') }}"><i class="bi bi-arrow-left me-1"></i> Kayıt sayfasına dön</a>
            </div>

        </div>
    </div>

    <script>
        const inputs = document.querySelectorAll('.otp-input');
        let submitted = false;

        function submitForm() {
            if (submitted) return;
            submitted = true;
            document.getElementById('submit-btn')?.setAttribute('disabled', 'disabled');
            document.getElementById('otp-form')?.submit();
        }

        inputs.forEach((input, idx) => {
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && idx > 0) {
                    inputs[idx - 1].focus();
                }
            });

            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/, '');

                if (input.value) {
                    input.classList.add('filled');
                    if (idx < inputs.length - 1) inputs[idx + 1].focus();
                } else {
                    input.classList.remove('filled');
                }

                const allFilled = [...inputs].every(i => i.value.length === 1);
                if (allFilled) {
                    setTimeout(submitForm, 200);
                }
            });

            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasted = e.clipboardData.getData('text').replace(/\D/g, '').slice(0, 6);
                pasted.split('').forEach((char, i) => {
                    if (inputs[i]) {
                        inputs[i].value = char;
                        inputs[i].classList.add('filled');
                    }
                });
                const next = Math.min(pasted.length, inputs.length - 1);
                inputs[next].focus();
                if (pasted.length === 6) {
                    setTimeout(submitForm, 200);
                }
            });
        });

        document.getElementById('otp-form')?.addEventListener('submit', (e) => {
            if (submitted) {
                e.preventDefault();
                return;
            }
            submitted = true;
            document.getElementById('submit-btn')?.setAttribute('disabled', 'disabled');
        });

        inputs[0]?.focus();

        {% if expiresAt %}
        const timerEl   = document.getElementById('timer');
        const timerWrap = document.getElementById('timer-wrap');

        const expiresAt = new Date('{{ expiresAt|date('Y-m-d\\TH:i:s', 'UTC') }}Z').getTime();

        function updateTimer() {
            const now  = Date.now();
            const diff = Math.max(0, Math.floor((expiresAt - now) / 1000));
            const m    = String(Math.floor(diff / 60)).padStart(2, '0');
            const s    = String(diff % 60).padStart(2, '0');

            if (diff === 0) {
                if (timerWrap) {
                    timerWrap.innerHTML =
                        '⏱ Kodun süresi doldu. ' +
                        '<a href="#" onclick="document.getElementById(\'resend-form\').submit();return false;" ' +
                        'style="color:#eab308;font-weight:600;text-decoration:underline">Yeni kod al →</a>';
                }
                document.querySelectorAll('.otp-input').forEach(i => {
                    i.disabled = true;
                    i.classList.add('error');
                });
                document.getElementById('submit-btn')?.setAttribute('disabled', 'disabled');
                clearInterval(timerInterval);
                return;
            }

            if (timerEl) {
                timerEl.textContent = m + ':' + s;

                if (diff <= 30) {
                    timerEl.style.color = '#ef4444';
                }
            }
        }

        updateTimer();
        const timerInterval = setInterval(updateTimer, 1000);
        {% endif %}
    </script>
{% endblock %}