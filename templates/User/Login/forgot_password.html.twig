{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <title>BAM | Şifremi Unuttum</title>
    <style>
        body {
            background-color: #0b0c10;
            font-family: 'Outfit', sans-serif;
            color: #e2e8f0;
            margin: 0;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            position: relative;
        }

        .auth-container::before {
            content: '';
            position: absolute;
            top: -20%;
            right: -10%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(234,179,8,0.08) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .auth-wrapper {
            background: #121318;
            border: 1px solid #1f2129;
            border-radius: 24px;
            box-shadow: 0 30px 60px -15px rgba(0,0,0,0.6);
            width: 100%;
            max-width: 460px;
            padding: 3.5rem 3rem;
            position: relative;
            z-index: 10;
            text-align: center;
        }

        .logo-box {
            width: 64px;
            height: 64px;
            background: #eab308;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 2rem;
            box-shadow: 0 12px 24px -6px rgba(234,179,8,0.4);
            color: #0b0c10;
        }

        .form-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .form-subtitle {
            color: #94a3b8;
            font-size: 0.95rem;
            margin-bottom: 2rem;
            line-height: 1.7;
        }

        .flash-alert {
            padding: 1rem 1.25rem;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-align: left;
        }

        .flash-error {
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.2);
            color: #ef4444;
        }

        .flash-success {
            background: rgba(34,197,94,0.1);
            border: 1px solid rgba(34,197,94,0.2);
            color: #22c55e;
        }

        .flash-warning {
            background: rgba(234,179,8,0.1);
            border: 1px solid rgba(234,179,8,0.2);
            color: #eab308;
        }

        .form-group {
            text-align: left;
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 500;
            color: #64748b;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 0.45rem;
        }

        .form-group input {
            width: 100%;
            background: #0b0c10;
            border: 2px solid #232530;
            border-radius: 12px;
            color: #e2e8f0;
            font-family: 'Outfit', sans-serif;
            font-size: 0.95rem;
            padding: 0.85rem 1rem;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            box-sizing: border-box;
        }

        .form-group input:focus {
            border-color: #eab308;
            box-shadow: 0 0 0 4px rgba(234,179,8,0.12);
        }

        .btn-custom {
            background: #eab308;
            color: #0b0c10;
            border: none;
            border-radius: 12px;
            padding: 1.1rem;
            font-size: 1.05rem;
            font-weight: 700;
            width: 100%;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
            box-shadow: 0 8px 20px -6px rgba(234,179,8,0.4);
        }

        .btn-custom:hover {
            background: #facc15;
            transform: translateY(-2px);
        }

        .btn-custom:active {
            transform: translateY(0);
        }

        .bottom-link {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.9rem;
            border-top: 1px solid #1f2129;
            padding-top: 1.5rem;
        }

        .bottom-link a {
            color: #eab308;
            font-weight: 600;
            text-decoration: none;
        }

        .bottom-link a:hover {
            opacity: 0.8;
        }

        @media (max-width: 450px) {
            .auth-wrapper {
                padding: 2.5rem 1.5rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="auth-container">
        <div class="auth-wrapper">

            <div class="logo-box">
                <i class="bi bi-key-fill"></i>
            </div>

            <h2 class="form-title">Şifremi Unuttum</h2>
            <p class="form-subtitle">
                Kayıtlı e-posta adresinizi girin.<br>
                Size 6 haneli sıfırlama kodu göndereceğiz.
            </p>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-alert flash-{{ type == 'danger' or type == 'error' ? 'error' : (type == 'warning' ? 'warning' : 'success') }}">
                        <i class="bi bi-{{ type == 'danger' or type == 'error' ? 'exclamation-triangle' : (type == 'warning' ? 'exclamation-circle' : 'check-circle') }}-fill"></i>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {{ form_start(requestForm, {attr: {novalidate: 'novalidate'}}) }}

            <div class="form-group">
                {{ form_label(requestForm.email) }}
                {{ form_widget(requestForm.email) }}
                {% for error in requestForm.email.vars.errors %}
                    <div style="color:#ef4444; font-size:0.8rem; margin-top:0.35rem;">
                        <i class="bi bi-exclamation-circle me-1"></i>{{ error.message }}
                    </div>
                {% endfor %}
            </div>

            <button type="submit" class="btn-custom">
                Kod Gönder <i class="bi bi-send-fill ms-1"></i>
            </button>

            {{ form_end(requestForm) }}

            <div class="bottom-link">
                <a href="{{ path('app_login') }}">
                    <i class="bi bi-arrow-left me-1"></i> Giriş sayfasına dön
                </a>
            </div>

        </div>
    </div>
{% endblock %}