<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="icon" style="border-radius: 20px" type="image/png" href="{{ asset('images/logo/bam-logo.ico') }}?v=1">
    <title>BAM | Arama Motoru</title>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #121826;
            color: #f3f4f6;
        }
        .card-custom {
            background-color: #1f2937;
            border: 1px solid #374151;
            border-radius: 1rem;
        }
        .card-inner {
            background-color: #374151;
            border: 1px solid #4b5563;
        }
        .text-yellow-custom { color: #eab308; }
        .btn-yellow-custom {
            background-color: #ca8a04;
            color: white;
            border: none;
        }
        .btn-yellow-custom:hover { background-color: #a16207; color: white; }
        .bg-green-soft { background-color: rgba(22, 101, 52, 0.3); border-color: #166534; }
        .bg-red-soft { background-color: rgba(153, 27, 27, 0.3); border-color: #991b1b; }
        .tracking-widest { letter-spacing: 0.1em; }
        .ai-summary-box {
            background-color: #111827;
            border: 1px solid #1f2937;
            border-radius: 0.75rem;
            padding: 1.25rem;
            color: #d1d5db;
        }
        .custom-badge-hover:hover {
            background-color: #ca8a04 !important;
        }
    </style>
    <link rel="stylesheet" href="{{ asset('css/bam-personal.css') }}?v=1">
</head>
<body class="bam-page">

{% include 'partials/_dashboard_header.html.twig' %}

<div class="container bam-shell py-4 py-lg-5" style="max-width: 800px;">

    <h2 class="text-center mb-5 font-weight-bold tracking-widest text-yellow-custom">
        📊 HİSSE ANALİZ MERKEZİ
    </h2>

    <div class="card-custom p-3 mb-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="text-yellow-custom fw-bold mb-0">🕘 SON ARANAN HİSSELER</h6>
            <button onclick="temizleSonArananlar()" class="btn btn-sm btn-link text-secondary text-decoration-none p-0">
                Temizle
            </button>
        </div>
        <div id="sonArananlarList" class="d-flex flex-wrap gap-2"></div>
    </div>

    <div class="card-custom p-4 mb-5 shadow">
        <form method="get" class="d-flex gap-3">
            <div class="input-group flex-grow-1">
                <span class="input-group-text bg-dark border-secondary text-secondary">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="symbol" value="{{ symbol|default('') }}"
                       class="form-control bg-dark border-secondary text-white fw-bold tracking-widest text-uppercase"
                       placeholder="HİSSE KODU GİRİN (ÖRN: THYAO)" required>
            </div>
            <button type="submit" class="btn btn-yellow-custom fw-bold px-4 rounded-3 shadow">
                ANALİZ ET
            </button>
        </form>
    </div>

    {% if stock %}
        {% set degisim = stock.price - stock.previousClose %}
        {% set yuzde = stock.previousClose > 0 ? (degisim / stock.previousClose) * 100 : 0 %}
        {% set text_renk = degisim >= 0 ? 'text-success' : 'text-danger' %}
        {% set card_bg = degisim >= 0 ? 'bg-green-soft' : 'bg-red-soft' %}
        {% set ikon = degisim >= 0 ? '▲' : '▼' %}

        <div class="card-custom shadow-lg overflow-hidden mb-4 border-0">
            <div class="p-4 border-bottom border-secondary d-flex justify-content-between align-items-center {{ card_bg }}">
                <div>
                    <h1 class="display-4 fw-bolder mb-0 tracking-widest">{{ stock.symbol|upper }}</h1>
                    <small class="text-secondary font-monospace">SON GÜNCELLEME: {{ stock.createdAt|date('d.m.Y H:i:s') }}</small>
                </div>
                <div class="text-end">
                    <div class="display-5 font-monospace fw-bold">{{ stock.price|number_format(2, ',', '.') }} <span class="fs-4 text-secondary">₺</span></div>
                    <div class="fs-5 fw-bold {{ text_renk }} d-flex justify-content-end align-items-center gap-2 mt-1">
                        <span>{{ ikon }}</span>
                        <span>{{ degisim|number_format(2, ',', '.') }}</span>
                        <span class="badge bg-dark text-light border border-secondary">%{{ yuzde|abs|number_format(2, ',', '.') }}</span>
                    </div>
                </div>
            </div>

            <div class="row g-0 border-bottom border-secondary" style="background-color: #374151;">
                <div class="col-6 col-md-3 p-3 text-center border-end border-bottom border-secondary">
                    <small class="text-secondary fw-bold tracking-widest d-block mb-1">AÇILIŞ</small>
                    <span class="fs-5 fw-bold font-monospace text-light">{{ stock.open|number_format(2, ',', '.') }}</span>
                </div>
                <div class="col-6 col-md-3 p-3 text-center border-end border-bottom border-secondary">
                    <small class="text-secondary fw-bold tracking-widest d-block mb-1">GÜN YÜKSEĞİ</small>
                    <span class="fs-5 fw-bold font-monospace text-success">{{ stock.high|number_format(2, ',', '.') }}</span>
                </div>
                <div class="col-6 col-md-3 p-3 text-center border-end border-secondary">
                    <small class="text-secondary fw-bold tracking-widest d-block mb-1">GÜN DÜŞÜĞÜ</small>
                    <span class="fs-5 fw-bold font-monospace text-danger">{{ stock.low|number_format(2, ',', '.') }}</span>
                </div>
                <div class="col-6 col-md-3 p-3 text-center border-secondary">
                    <small class="text-secondary fw-bold tracking-widest d-block mb-1">ÖNC. KAPANIŞ</small>
                    <span class="fs-5 fw-bold font-monospace text-light">{{ stock.previousClose|number_format(2, ',', '.') }}</span>
                </div>
            </div>

            <div class="p-3 d-flex justify-content-between align-items-center">
                <span class="text-secondary small fw-bold tracking-widest">TOPLAM HACİM (LOT)</span>
                <span class="fs-4 font-monospace fw-bold text-primary">{{ stock.volume|number_format(0, ',', '.') }}</span>
            </div>
        </div>

        <div class="text-center mt-5">
            <button onclick="toggleNewsList()" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow">
                <span id="arrowIcon" class="me-2">⬇️</span> Yapay Zeka Analizlerini Göster
            </button>

            <div id="newsListContainer" class="d-none mt-4 text-start">
                {% if newsList is defined and newsList is not empty %}
                    <ul class="list-unstyled d-flex flex-column gap-3">
                        {% for news in newsList %}
                            <li class="card-custom p-4 shadow-sm">
                                <div class="d-flex justify-content-between align-items-start border-bottom border-secondary pb-3 mb-3">
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="small text-secondary">Puan:</span>
                                            <span class="fs-5 fw-bold {{ news.sentimentScore >= 70 ? 'text-success' : (news.sentimentScore <= -70 ? 'text-danger' : 'text-warning') }}">
                                                {{ news.sentimentScore }} / 100
                                            </span>
                                        </div>
                                        <div class="small text-secondary">Tarih: {{ news.publishedAt|date('d.m.Y H:i') }}</div>
                                    </div>
                                    <a href="https://www.kap.org.tr/tr/Bildirim/{{ news.kapId }}" target="_blank" rel="noopener noreferrer" class="link-info text-decoration-none small fw-bold">
                                        KAP'ta Gör <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                                <div class="ai-summary-box small">
                                    {{ news.aiSummary|nl2br }}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                {% elseif symbol is defined and symbol is not empty %}
                    <div class="card-custom text-secondary p-4 text-center">
                        <p class="mb-0">"{{ symbol }}" için son 1 haftaya ait KAP haberi veya analizi bulunamadı.</p>
                    </div>
                {% else %}
                    <div class="card-custom text-secondary p-4 text-center">
                        <p class="mb-0">Lütfen bir hisse sembolü arayın.</p>
                    </div>
                {% endif %}
            </div>
        </div>

    {% elseif symbol is defined and symbol is not empty %}
        <div class="alert alert-danger bg-red-soft border-danger text-danger text-center rounded-4 p-4">
            <h5 class="fw-bold mb-1">⚠️ Veri Bulunamadı</h5>
            <small>"{{ symbol }}" sembolü için veritabanında kayıtlı veri yok.</small>
        </div>
    {% else %}
        <div class="text-center text-secondary mt-5">
            <p class="fs-5">Analiz yapmak için yukarıya bir hisse kodu girin.</p>
        </div>
    {% endif %}

</div>

<div class="position-fixed bottom-0 end-0 p-3">
    <button onclick="localStorageTemizle()" class="btn btn-danger btn-sm shadow">
        <i class="bi bi-trash3"></i> Tümünü Temizle
    </button>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        sonArananlariGoster();
    });

    let symbol = "{{ symbol|default('') }}";

    if (symbol && symbol.trim() !== '') {
        symbol = symbol.toUpperCase().trim();

        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];

        if (!arananlar.includes(symbol)) {
            arananlar.unshift(symbol);
            if (arananlar.length > 20) {
                arananlar.pop();
            }
            localStorage.setItem('arananSymbolList', JSON.stringify(arananlar));
        }
    }

    function sonArananlariGoster() {
        let arananlar = JSON.parse(localStorage.getItem('arananSymbolList')) || [];
        let listeHtml = document.getElementById('sonArananlarList');

        if (arananlar.length === 0) {
            listeHtml.innerHTML = '<span class="text-secondary small">Henüz aranan hisse yok</span>';
            return;
        }

        listeHtml.innerHTML = arananlar.map(symbol =>
            `<a href="?symbol=${symbol}" class="badge bg-secondary text-decoration-none p-2 custom-badge-hover">
                ${symbol}
            </a>`
        ).join('');
    }

    function temizleSonArananlar() {
        localStorage.removeItem('arananSymbolList');
        sonArananlariGoster();
    }

    function localStorageTemizle() {
        if (confirm('Tüm localStorage verilerini temizlemek istediğinize emin misiniz?')) {
            localStorage.clear();
            sonArananlariGoster();
        }
    }

    function toggleNewsList() {
        const container = document.getElementById('newsListContainer');
        const arrow = document.getElementById('arrowIcon');

        if (container.classList.contains('d-none')) {
            container.classList.remove('d-none');
            arrow.textContent = '⬆️';
        } else {
            container.classList.add('d-none');
            arrow.textContent = '⬇️';
        }
    }
</script>

</body>
</html>
