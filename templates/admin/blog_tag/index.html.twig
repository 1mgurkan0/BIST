{% extends 'admin/base.html.twig' %}

{% block title %}Etiketler{% endblock %}
{% block page_title %}Etiketler{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="admin-card p-4">
                <h6 class="text-secondary text-uppercase small mb-3">Yeni Etiket</h6>
                <form method="post" action="{{ path('admin_blog_tag_new') }}">
                    <div class="mb-3">
                        <input type="text" name="name" class="form-control" placeholder="Etiket adı" required>
                    </div>
                    <button type="submit" class="btn btn-warning fw-bold text-dark w-100">
                        <i class="bi bi-plus-lg"></i> Ekle
                    </button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="admin-card p-0">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th class="ps-3">Ad</th>
                            <th>Slug</th>
                            <th class="text-end pe-3">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tag in tags %}
                            <tr>
                                <td class="ps-3">{{ tag.name }}</td>
                                <td class="text-secondary small">{{ tag.slug }}</td>
                                <td class="text-end pe-3">
                                    <form method="post" action="{{ path('admin_blog_tag_delete', {id: tag.id}) }}" class="d-inline" onsubmit="return confirm('Silinsin mi?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-tag-' ~ tag.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-secondary py-4">Henüz etiket yok.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}