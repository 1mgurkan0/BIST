{% extends 'admin/base.html.twig' %}

{% block title %}Yazılar{% endblock %}
{% block page_title %}Yazılar{% endblock %}

{% block content %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('admin_blog_post_new') }}" class="btn btn-warning fw-bold text-dark">
            <i class="bi bi-plus-lg"></i> Yeni Yazı
        </a>
    </div>

    <div class="admin-card p-0">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th class="ps-3">Başlık</th>
                    <th>Durum</th>
                    <th>Kategori</th>
                    <th>Tarih</th>
                    <th class="text-end pe-3">İşlem</th>
                </tr>
            </thead>
            <tbody>
                {% for post in posts %}
                    <tr>
                        <td class="ps-3">{{ post.title }}</td>
                        <td>
                            {% if post.status == 'published' %}
                                <span class="badge bg-success">Yayında</span>
                            {% elseif post.status == 'scheduled' %}
                                <span class="badge bg-warning text-dark">Zamanlanmış</span>
                            {% else %}
                                <span class="badge bg-secondary">Taslak</span>
                            {% endif %}
                        </td>
                        <td>{{ post.category ? post.category.name : '-' }}</td>
                        <td class="text-secondary small">{{ post.createdAt ? post.createdAt|date('d.m.Y') : '-' }}</td>
                        <td class="text-end pe-3">
                            <a href="{{ path('admin_blog_post_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-light">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="{{ path('admin_blog_post_delete', {id: post.id}) }}" class="d-inline" onsubmit="return confirm('Bu yazıyı silmek istediğine emin misin?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete-post-' ~ post.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-4">Henüz yazı yok.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}