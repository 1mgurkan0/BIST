# Runtime
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
DEFAULT_URI=https://bist.example.com

# MySQL (URL-encode special characters in DATABASE_URL)
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_NAME=bist_db
DB_USER=bist_user
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL="mysql://bist_user:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3306/bist_db?serverVersion=8.0.37&charset=utf8mb4"

# Runtime infrastructure
REDIS_URL=redis://127.0.0.1:6379
LOCK_DSN=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Optional comma-separated override for the default large-cap scan universe:
# BIST_SCAN_SYMBOLS=ASELS,THYAO,AKBNK

# Integrations
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
MAILER_DSN=null://null
